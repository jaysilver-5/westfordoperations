# Optional public address displayed in the footer. Set only to an existing mailbox.
NEXT_PUBLIC_CONTACT_EMAIL=

# REQUIRED for live trial/review enquiries.
# Receive in your existing business inbox (for example, the one hosted with Zoho).
# These stay SERVER-ONLY: do not add NEXT_PUBLIC_.
CONTACT_TO_EMAIL=
# Sender must use an address/domain verified in Resend.
# A sending-only subdomain can keep Zoho's existing MX records unchanged.
CONTACT_FROM_EMAIL=
RESEND_API_KEY=

# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Public Cal.com or Calendly event URL. The booking page only opens verified provider links.
# Set up your actual calendar, event type, and automatic invitations with the provider.
# No email-to-arrange-call option or fake time slots are offered when unset.
BOOKING_URL=
