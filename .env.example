# Public business email used in every email link and prepared enquiry.
# Add your real address, then restart locally or rebuild on your host.
# The inbox must be created with your email host before it can receive mail.
NEXT_PUBLIC_CONTACT_EMAIL=hello@westfordoperations.com

# Server-only delivery credential. Never add NEXT_PUBLIC_ to this key.
# Verify your sending domain with Resend before enabling live delivery.
RESEND_API_KEY=
# Optional: defaults to the public business email above.
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Public Calendly or Cal.com event link for the /book page.
# Example: https://calendly.com/your-team/intro-call
# No invented time slots are displayed if this is unset.
NEXT_PUBLIC_BOOKING_URL=
